    "pat": "https://microservices.io/patterns/ns#",
    "ArchitecturalPattern": {
      "@id": "schema:HowTo",
      "@type": "@id"
    },
    "name": {
      "@id": "schema:name"
    },
    "description": {
      "@id": "schema:description"
    },
    "category": {
      "@id": "schema:category"
    },
