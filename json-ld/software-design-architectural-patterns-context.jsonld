    },
    "Hexagonal": {
      "@id": "arch:HexagonalPattern"
    },
    "Serverless": {
      "@id": "arch:ServerlessPattern"
    },
    "LayeredArchitecture": {
      "@id": "arch:LayeredPattern"
    }
  }
}
